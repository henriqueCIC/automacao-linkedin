# ==========================================
# Automação LinkedIn - Configurações de Ambiente
# ==========================================

# --- Supabase (Banco de Dados e Auth) ---
# Copie do painel do seu projeto Supabase: Project Settings -> API
SUPABASE_URL=https://sua-url-supabase.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publicavel
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-admin

# Variáveis do cliente (Vite)
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publicavel

# --- Inteligência Artificial (Escolha uma) ---
# Opção 1 (Recomendada): Google Gemini (gratuito em https://aistudio.google.com/)
GEMINI_API_KEY=sua-chave-gemini-aqui
# GEMINI_MODEL=gemini-2.0-flash

# Opção 2: OpenAI (https://platform.openai.com/)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- GitHub OAuth (Para ler seus commits) ---
# Crie em: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:8080/oauth/github/return (ou sua URL de produção)
GITHUB_CLIENT_ID=seu-github-client-id
GITHUB_CLIENT_SECRET=seu-github-client-secret

# --- LinkedIn API (Para publicar posts aprovados) ---
# Crie em: https://www.linkedin.com/developers -> Create App
LINKEDIN_ACCESS_TOKEN=seu-token-de-acesso-ou-api-key

# --- Segurança e Automação ---
# Chave de 32 bytes (base64) para criptografar tokens salvos no banco
# Gere no terminal com: openssl rand -base64 32
ENCRYPTION_SECRET=
CRON_SECRET=seu-segredo-de-cron-para-disparos-automaticos
